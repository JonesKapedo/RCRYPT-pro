# RockyCrypt configuration — copy to .env and fill in real values.
# NEVER commit the filled-in file.

# ── Core ──────────────────────────────────────────────────────────────────────
# true enables strict security enforcement (CORS allowlist required, HSTS/CSP
# headers, HTTPS-only admin login). Missing/weak secrets abort startup.
ROCKYCRYPT_PRODUCTION=false
ROCKYCRYPT_HOST=127.0.0.1
ROCKYCRYPT_PORT=5000
ROCKYCRYPT_CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# ── Secrets ───────────────────────────────────────────────────────────────────
# python -c "import secrets; print(secrets.token_urlsafe(64))"   (>= 32 bytes)
ROCKYCRYPT_JWT_SECRET=
# python -c "import secrets; print(secrets.token_urlsafe(64))"
ROCKYCRYPT_UNSUBSCRIBE_SECRET=
# python -c "import secrets; print(secrets.token_urlsafe(24))"
ROCKYCRYPT_ADMIN_SECRET=

# ── Email (optional) ──────────────────────────────────────────────────────────
ROCKYCRYPT_SMTP_HOST=smtp.gmail.com
ROCKYCRYPT_SMTP_PORT=587
ROCKYCRYPT_SMTP_USER=
ROCKYCRYPT_SMTP_PASS=
ROCKYCRYPT_FROM_EMAIL=

# ── Payments (optional) ───────────────────────────────────────────────────────
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
